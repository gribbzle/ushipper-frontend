{
    "compilerOptions": {
        "target": "es5",
        "lib": ["dom", "dom.iterable", "esnext"],
        "downlevelIteration": true,
        "types": ["cypress", "cypress-file-upload"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "paths": {
            "@api": ["./src/api/index"],
            "@enums": ["./src/enums/index"],
            "@hooks": ["./src/hooks/index"],
            "@components": ["./src/components/index"],
            "@constants": ["./src/constants/index"],
            "@fields": ["./src/fields/index"],
            "@store": ["./src/store/index"],
            "@store/*": ["./src/store/*"],
            "@utils": ["./src/utils/index"],
            "@icons": ["./src/assets/icons/index"],
            "@images": ["./src/assets/images/index"],
            "@logo": ["./src/assets/logos/index"],
            "@validators": ["./src/validators/index"],
            "@ui": ["./src/components/ui/index"],
            "@providers": ["./src/providers/index"],
            "@schemas": ["./src/schemas/index"],
            "@types": ["./src/types/index"],
            "@/*": ["./src/*"]
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
}
