{
    "name": "ushipper-ui",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "tsc": "tsc",
        "build": "npm run-script build:next && npm run-script build:fastify",
        "build:next": "next build",
        "build:fastify": "tsc --build build.tsconfig.json",
        "start": "cross-env NODE_ENV=production node ./dist/server/index.js",
        "start:test": "cross-env NODE_ENV=test ts-node ./server/index.ts",
        "start:dev": "cross-env NODE_ENV=development ts-node ./server/index.ts",
        "start:mock": "cross-env NODE_ENV=development MOCK=true ts-node ./server/index.ts",
        "lint": "next lint",
        "stylelint": "stylelint src/**/*.scss",
        "stylelint:fix": "stylelint src/**/*.scss --fix",
        "eslint": "eslint . --ext .ts,.tsx",
        "eslint:fix": "eslint . --ext .ts,.tsx --fix",
        "eslint:watch": "cross-env NODE_ENV=development nodemon --watch . --ext .ts,.tsx --exec \"npm run-script eslint\"",
        "prepare": "husky install",
        "lint-staged": "lint-staged",
        "cy:open": "cypress open",
        "cy:run": "cypress run"
    },
